# ==============================================================================
# Environment Configuration for Docker Compose Stack
# Idempotent Event Processing System
# ==============================================================================

# Active Spring Boot profile for container environment
SPRING_PROFILES_ACTIVE=docker

# PostgreSQL Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=event_processor
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Apache Kafka Configuration (KRaft Mode)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Redis Fast-Path Cache Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Idempotency Engine & Lease Settings
IDEMPOTENCY_LEASE_DURATION=60s
IDEMPOTENCY_CACHE_TTL=24h

# Host Port Mappings (ports exposed on the host machine)
HOST_APP_PORT=8080
HOST_DB_PORT=5432
HOST_KAFKA_PORT=9094
HOST_REDIS_PORT=6379
